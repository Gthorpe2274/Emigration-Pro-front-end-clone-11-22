# Copy to .env for local development. Netlify holds the real values for the
# deployed site (Site settings > Environment variables).
#
# Everything here is inlined into the client bundle at build time by Vite, so
# VITE_* values are PUBLIC. Never put a Stripe secret key or webhook secret here
# — those belong in the Worker's secrets (wrangler secret put).

# Live Stripe Payment Link. A public URL, safe to expose.
# Changing this requires a redeploy; see ROTATING_THE_STRIPE_LINK.md.
VITE_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/8x29ALbq1apu5rbe4tefC06

VITE_GEMINI_API_KEY=
VITE_CLARITY_PROJECT_ID=
VITE_UNSPLASH_ACCESS_KEY=
