{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emigration-pro",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emigration-pro-db",
      "database_id": "50988161-3867-41b2-bb1e-174b54c167d8"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "REPORTS_KV",
      "id": "d9b6191b7e71482c93a3f99f70c37db9",
      "preview_id": "b39c60cdd504843c7ae19dcfa590c4561"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "emigration-pro-bucket"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "IMMIGRATION_AUDIT_QUEUE",
        "queue": "immigration-audit"
      }
    ],
    "consumers": [
      {
        "queue": "immigration-audit",
        "max_batch_size": 2,
        "max_batch_timeout": 5,
        "max_retries": 4,
        "retry_delay": 60,
        "dead_letter_queue": "immigration-audit-dlq",
        "max_concurrency": 3
      }
    ]
  },
  "triggers": {
    "crons": [
      "0 2 * * *",
      "0 3 1 */3 *",
      "0 4 1 * *"
    ]
  }
}
